DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TUNNEL_HOST=
# Aplica-se apenas ao perfil do túnel. O valor é em segundos.
DJANGO_HSTS_SECONDS=300
DATABASE_URL=sqlite:///db.sqlite3

# Preencha os quatro valores para ativar R2. No Render eles são obrigatórios.
# Em desenvolvimento, deixe-os vazios para usar a pasta de mídia local.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

MP_ACCESS_TOKEN=
MP_TEST_SELLER_ID=
MP_TEST_BUYER_EMAIL=
MP_WEBHOOK_SECRET=
MP_BACK_URL=

# Pix Asaas funciona apenas em sandbox. Guarde ambos os segredos no backend.
ASAAS_ENVIRONMENT=disabled
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
